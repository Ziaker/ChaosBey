{
  "name": "chaosbey",
  "version": "0.15.1",
  "private": true,
  "description": "ChaosBey - 3D spinning-top arena combat simulator (browser, GitHub Pages)",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "playwright test -c tests/smoke/playwright.config.ts",
    "build:exe": "npm run build && electron-builder --win --publish=never",
    "build:mac": "npm run build && electron-builder --mac --publish=never"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/three": "0.186.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "build": {
    "appId": "com.chaosbey.desktoptest",
    "productName": "ChaosBey",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "!node_modules/**/*"
    ],
    "asar": false,
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "ChaosBey-Portable.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": ["x64", "arm64"]
        }
      ],
      "identity": null
    }
  }
}
